'][data-name='contacts'], [data-name='contacts'] [data-action='add'], [data-type='contact'] [data-action='edit']\", \"isDisabled\": true, \"onComplete\": \"process_function_hasContact\", \"description\": \"Make sure we have an information contact. Contact with the \\\"General\\\" role.\", \"isCompleted\": false}, \"4\": {\"cost\": 0, \"name\": \"Do we have a business account manager?\", \"value\": \"Delegation\", \"emphasize\": \"[data-bs-toggle='tab'][data-name='contacts'], [data-name='contacts'] [data-action='add'], [data-type='contact'] [data-action='edit']\", \"isDisabled\": true, \"onComplete\": \"process_function_hasContact\", \"description\": \"Make sure we have a business account manager contact. Contact with the \\\"Delegation\\\" role.\", \"isCompleted\": false}}, \"description\": \"Validate the information of the client.\", \"isCompleted\": false}, \"4\": {\"icon\": \"arrow-repeat\", \"name\": \"In Progress\", \"color\": \"blue\", \"tasks\": {\"1\": {\"cost\": 0, \"name\": \"Request delegation\", \"value\": \"https://ccp-pcc.cbsa-asfc.cloud-nuage.canada.ca/en/auth/login\", \"emphasize\": null, \"isDisabled\": false, \"onComplete\": \"process_function_openURL\", \"description\": \"Open\", \"isCompleted\": false}, \"2\": {\"cost\": 0, \"name\": \"Delegation request sent\", \"value\": \"Have you requested delegation?\", \"emphasize\": null, \"isDisabled\": false, \"onComplete\": \"process_function_requestConfirmation\", \"description\": \"Confirm that you have sent the delegation request to the importer\", \"isCompleted\": false}, \"3\": {\"cost\": 0, \"name\": \"Notify the importer\", \"value\": null, \"emphasize\": null, \"isDisabled\": false, \"onComplete\": null, \"description\": \"Send an email notification to the importer's business account manager so he/she can accept the request.\", \"isCompleted\": false}, \"4\": {\"cost\": 0, \"name\": \"Delegation has been accepted\", \"value\": \"Has the delegation request been accepted\", \"emphasize\": null, \"isDisabled\": false, \"onComplete\": \"process_function_requestConfirmation\", \"description\": \"Verify that the delegation request has been accepted\", \"isCompleted\": false}}, \"description\": \"Obtain the delegation in CARM.\", \"isCompleted\": false}, \"5\": {\"icon\": \"check-circle\", \"name\": \"Completed\", \"color\": \"success\", \"tasks\": {\"1\": {\"cost\": 0, \"name\": \"Completed\", \"value\": null, \"emphasize\": null, \"isDisabled\": true, \"onComplete\": \"process_function_DelegateClient\", \"description\": \"The process is completed and trigger the assessment report request\", \"isCompleted\": false}}, \"description\": \"The process is completed\", \"isCompleted\": false}}",

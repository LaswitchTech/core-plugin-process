    {
        "id": 1,
        "created": "2025-04-07 15:10:38",
        "modified": "2025-04-07 15:10:38",
        "owner": "demo",
        "category": "Lead",
        "description": "This is the lead process. It describes all the stages, steps and tasks that need to be accomplished.",
        "process": "{\"1\": {\"icon\": \"folder\", \"name\": \"Open\", \"color\": \"primary\", \"tasks\": {\"1\": {\"cost\": 0, \"name\": \"Open\", \"value\": null, \"isDisabled\": true, \"onComplete\": null, \"description\": \"Open the Lead.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Opening the Lead.\", \"isCompleted\": false}, \"2\": {\"icon\": \"eyeglasses\", \"name\": \"Vetting\", \"color\": \"pink\", \"tasks\": {\"1\": {\"cost\": 0, \"name\": \"Learn about the Lead\", \"value\": null, \"isDisabled\": false, \"onComplete\": null, \"description\": \"Review the Lead's Website, Social Media, and other online presence.\", \"isCompleted\": false}, \"2\": {\"cost\": 0, \"name\": \"Check the accuracy of the information\", \"value\": null, \"isDisabled\": false, \"onComplete\": null, \"description\": \"Check the accuracy of the information provided by the Lead.\", \"isCompleted\": false}, \"3\": {\"cost\": 0, \"name\": \"Retrieve the Website\", \"value\": \"website\", \"isDisabled\": false, \"onComplete\": \"process_function_hasvCardProperty\", \"description\": \"Retrieve the lead's website.\", \"isCompleted\": false}, \"4\": {\"cost\": 0, \"name\": \"Retrieve the Logo\", \"value\": null, \"isDisabled\": false, \"onComplete\": null, \"description\": \"Retrieve the lead's logo from the website. And save it as logo on the file.\", \"isCompleted\": false}, \"5\": {\"cost\": \"0\", \"name\": \"Is there potential?\", \"value\": null, \"isDisabled\": false, \"onComplete\": null, \"description\": \"Prospect has been vetted and we want to engage with a contract.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Learn about this Lead and Evaluate if it's a good fit.\", \"isCompleted\": false}, \"3\": {\"icon\": \"person-add\", \"name\": \"Assign\", \"color\": \"purple\", \"tasks\": {\"1\": {\"cost\": 0, \"name\": \"Assign a Marketer\", \"value\": null, \"isDisabled\": false, \"onComplete\": \"process_function_TaskAssign\", \"description\": \"Assign a Marketer to the Lead.\", \"isCompleted\": false}, \"2\": {\"cost\": 0, \"name\": \"Activate the task\", \"value\": null, \"isDisabled\": true, \"onComplete\": \"process_function_TaskActivate\", \"description\": \"Activate the task and make it available for the Marketer.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Assign a Marketer to the Lead.\", \"isCompleted\": false}, \"4\": {\"icon\": \"telephone\", \"name\": \"Contact\", \"color\": \"light\", \"tasks\": {\"1\": {\"cost\": 0, \"name\": \"Schedule a Call\", \"value\": \"Callback\", \"isDisabled\": false, \"onComplete\": \"process_function_FollowupCreate\", \"description\": \"Schedule a call with the Prospect.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Make contact with the Prospect.\", \"isCompleted\": false}, \"5\": {\"icon\": \"arrow-repeat\", \"name\": \"In Progress\", \"color\": \"blue\", \"tasks\": {\"1\": {\"cost\": 0, \"name\": \"Create an Authorization Letter\", \"value\": \"AL\", \"isDisabled\": false, \"onComplete\": \"process_function_DocumentCreate\", \"description\": \"Create an Authorization Letter to be sent to the prospect along with the agreement.\", \"isCompleted\": false}, \"2\": {\"cost\": 0, \"name\": \"Create an Agreement\", \"value\": \"DRA\", \"isDisabled\": false, \"onComplete\": \"process_function_DocumentCreate\", \"description\": \"Create a Dutry Review Agreement\", \"isCompleted\": false}, \"3\": {\"cost\": 0, \"name\": \"Send Agreement\", \"value\": \"DRA\", \"isDisabled\": false, \"onComplete\": \"process_function_DocumentSend\", \"description\": \"Send the signed Agreement to the Prospect.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Prepare an Agreement for the Prospect and Present it.\", \"isCompleted\": false}, \"6\": {\"icon\": \"check-circle\", \"name\": \"Profile\", \"color\": \"teal\", \"tasks\": {\"1\": {\"cost\": 0, \"name\": \"Do we have a business number?\", \"value\": \"businessNumber\", \"isDisabled\": true, \"onComplete\": \"process_function_hasvCardProperty\", \"description\": \"Make sure we have the Canada Revenue Agency business number.\", \"isCompleted\": false}, \"2\": {\"cost\": 0, \"name\": \"Do we have an importer extension?\", \"value\": \"importerExtension\", \"isDisabled\": true, \"onComplete\": \"process_function_hasvCardProperty\", \"description\": \"Make sure we have the 6-digit alpha-numerical CBSA RM import-export sub-account.\", \"isCompleted\": false}, \"3\": {\"cost\": \"0\", \"name\": \"Do we have an information contact?\", \"value\": \"General\", \"isDisabled\": true, \"onComplete\": \"process_function_hasContact\", \"description\": \"Make sure we have an information contact. Contact with the \\\"General\\\" role.\", \"isCompleted\": false}, \"4\": {\"cost\": \"0\", \"name\": \"Do we have a billing contact?\", \"value\": \"Billing\", \"isDisabled\": true, \"onComplete\": \"process_function_hasContact\", \"description\": \"Make sure we have a billing contact. Contact with the \\\"Billing\\\" role.\", \"isCompleted\": false}, \"5\": {\"cost\": \"0\", \"name\": \"Do we have a documentation contact?\", \"value\": \"Documents\", \"isDisabled\": true, \"onComplete\": \"process_function_hasContact\", \"description\": \"Make sure we have a documentation contact. Contact with the \\\"Documents\\\" role.\", \"isCompleted\": false}, \"6\": {\"cost\": \"0\", \"name\": \"Do we have a business account manager?\", \"value\": \"Delegation\", \"isDisabled\": true, \"onComplete\": \"process_function_hasContact\", \"description\": \"Make sure we have a business account manager contact. Contact with the \\\"Delegation\\\" role.\", \"isCompleted\": false}, \"7\": {\"cost\": \"0\", \"name\": \"Do we have a signatory contact?\", \"value\": \"Signatory\", \"isDisabled\": true, \"onComplete\": \"process_function_hasContact\", \"description\": \"Make sure we have a signatory contact. Contact with the \\\"Signatory\\\" role.\", \"isCompleted\": false}, \"8\": {\"cost\": 0, \"name\": \"Create a Client Profile\", \"value\": null, \"isDisabled\": false, \"onComplete\": \"process_function_ClientCreate\", \"description\": \"Create a Client Profile for the Prospect.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Validate the information of the client.\", \"isCompleted\": false}, \"7\": {\"icon\": \"vector-pen\", \"name\": \"Agreement\", \"color\": \"info\", \"tasks\": {\"1\": {\"cost\": \"0\", \"name\": \"Add the Audit Service\", \"value\": \"audit\", \"isDisabled\": false, \"onComplete\": \"process_function_ServicesAddProduct\", \"description\": \"Add the Audit Service to the Client Profile and Set the Commission Rates\", \"isCompleted\": false}, \"2\": {\"cost\": 0, \"name\": \"Save the Agreement\", \"value\": \"DRA-{{year}}-{{month}}-{{day}}-{{locale}}.pdf\", \"isDisabled\": false, \"onComplete\": \"process_function_FileUpload\", \"description\": \"Save the final Agreement on the Prospect.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Save the signed agreement into the Lead Profile.\", \"isCompleted\": false}, \"8\": {\"icon\": \"person-check-fill\", \"name\": \"Allocate\", \"color\": \"dark\", \"tasks\": {\"1\": {\"cost\": 0, \"name\": \"Deactivate the task\", \"value\": null, \"isDisabled\": true, \"onComplete\": \"process_function_TaskDeactivate\", \"description\": \"Deactivate the task and hide it for the Marketer.\", \"isCompleted\": false}, \"2\": {\"cost\": 0, \"name\": \"Allocate to a Consultant\", \"value\": null, \"isDisabled\": true, \"onComplete\": \"process_function_ClientIsAllocated\", \"description\": \"Allocate the Client to a Consultant.\", \"isCompleted\": false}, \"3\": {\"cost\": 0, \"name\": \"First Claim Approved\", \"value\": null, \"isDisabled\": true, \"onComplete\": \"process_function_ClaimHasApproved\", \"description\": \"The first claim has been approved.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Allocate the Client to a Consultant.\", \"isCompleted\": false}, \"9\": {\"icon\": \"arrow-repeat\", \"name\": \"Survey\", \"color\": \"orange\", \"tasks\": {\"1\": {\"cost\": 0, \"name\": \"Activate the task\", \"value\": null, \"isDisabled\": true, \"onComplete\": \"process_function_TaskActivate\", \"description\": \"Activate the task and make it available for the Marketer.\", \"isCompleted\": false}, \"2\": {\"cost\": 0, \"name\": \"Send Customer Survey\", \"value\": null, \"isDisabled\": false, \"onComplete\": \"process_function_SurveyCreate\", \"description\": \"Send a customer survey to the prospect.\", \"isCompleted\": false}, \"3\": {\"cost\": 0, \"name\": \"Create a Recommendation Letter\", \"value\": \"PRAISE\", \"isDisabled\": false, \"onComplete\": \"process_function_DocumentCreate\", \"description\": \"Create a recommandation letter for the prospect based on the answers provided in the customer survey.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"The claims are currently being processed.\", \"isCompleted\": false}, \"10\": {\"icon\": \"check-circle\", \"name\": \"Completed\", \"color\": \"success\", \"tasks\": {\"1\": {\"cost\": 0, \"name\": \"Mark as Closed\", \"value\": null, \"isDisabled\": true, \"onComplete\": \"process_function_ClientIsCompleted\", \"description\": \"All Services have been terminated and/or are Completed.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"The process is completed\", \"isCompleted\": false}}",
        "organization": 10000,
        "targetTable": "leads"
    },
    {
        "id": 2,
        "created": "2025-04-07 15:10:38",
        "modified": "2025-04-07 15:10:38",
        "owner": "demo",
        "category": "Client",
        "description": "This is the client process. It describes all the stages, steps and tasks that need to be accomplished.",
        "process": "{\"1\": {\"icon\": \"folder\", \"name\": \"Open\", \"color\": \"primary\", \"tasks\": {\"1\": {\"name\": \"Open\", \"value\": null, \"isDisabled\": true, \"onComplete\": null, \"description\": \"Open the Client.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Opening the Client.\", \"isCompleted\": false}, \"2\": {\"icon\": \"person-add\", \"name\": \"Assign\", \"color\": \"purple\", \"tasks\": {\"1\": {\"name\": \"Assign a Business Account Manager\", \"value\": null, \"isDisabled\": false, \"onComplete\": \"process_function_TaskAssign\", \"description\": \"Assign an Business Account Manager to the Client.\", \"isCompleted\": false}, \"2\": {\"name\": \"Activate the task\", \"value\": null, \"isDisabled\": true, \"onComplete\": \"process_function_TaskActivate\", \"description\": \"Activate the task and make it available for the Business Account Manager.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Assign an Business Account Manager to the Client.\", \"isCompleted\": false}, \"3\": {\"icon\": \"check-circle\", \"name\": \"Validation\", \"color\": \"info\", \"tasks\": {\"1\": {\"name\": \"Is the company registered?\", \"value\": null, \"isDisabled\": false, \"onComplete\": null, \"description\": \"Verify that the business number is valid.\", \"isCompleted\": false}, \"2\": {\"name\": \"Is the importer registered?\", \"value\": null, \"isDisabled\": false, \"onComplete\": null, \"description\": \"Verify that the business's importer extension is valid.\", \"isCompleted\": false}, \"3\": {\"name\": \"Does the address match the importer record?\", \"value\": null, \"isDisabled\": false, \"onComplete\": null, \"description\": \"Verify that the business's address matches with the importer record.\", \"isCompleted\": false}, \"4\": {\"name\": \"Do we have a billing contact?\", \"value\": \"Billing\", \"isDisabled\": true, \"onComplete\": \"process_function_hasContact\", \"description\": \"Make sure we have a billing contact.\", \"isCompleted\": false}, \"5\": {\"name\": \"Do we have an information contact?\", \"value\": \"General\", \"isDisabled\": true, \"onComplete\": \"process_function_hasContact\", \"description\": \"Make sure we have an information contact.\", \"isCompleted\": false}, \"6\": {\"name\": \"Add the Audit Service\", \"value\": \"000001\", \"isDisabled\": true, \"onComplete\": \"process_function_ProductAdd\", \"description\": \"Add the corresponding product with to the Client.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Validate the information of the client.\", \"isCompleted\": false}, \"4\": {\"icon\": \"check-circle\", \"name\": \"Delegation\", \"color\": \"orange\", \"tasks\": {\"1\": {\"name\": \"Send a Delegation Request\", \"value\": null, \"isDisabled\": false, \"onComplete\": null, \"description\": \"Send a Delegation Request\", \"isCompleted\": false}, \"2\": {\"name\": \"Send a Tutorial\", \"value\": null, \"isDisabled\": false, \"onComplete\": null, \"description\": \"Send a Guide to a contact of the prospect to help them with the delegation request.\", \"isCompleted\": false}, \"3\": {\"name\": \"Delegation Request Accepted\", \"value\": null, \"isDisabled\": false, \"onComplete\": null, \"description\": \"Has the delegation request been accepted?\", \"isCompleted\": false}, \"4\": {\"name\": \"Delegation Access Level Suffisant\", \"value\": null, \"isDisabled\": false, \"onComplete\": null, \"description\": \"Verify that the delegation provides the suffisant level of access\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Setup proper CARM Delegation.\", \"isCompleted\": false}, \"5\": {\"icon\": \"check-circle\", \"name\": \"Firm Report\", \"color\": \"red\", \"tasks\": {\"1\": {\"name\": \"Request a Firm Report\", \"value\": null, \"isDisabled\": false, \"onComplete\": null, \"description\": \"Request a Firm Report.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Request the firm report for older entries (prior to October 2024).\", \"isCompleted\": false}, \"6\": {\"icon\": \"person-add\", \"name\": \"Assign\", \"color\": \"purple\", \"tasks\": {\"1\": {\"name\": \"Unassign the Business Account Manager\", \"value\": null, \"isDisabled\": true, \"onComplete\": \"process_function_TaskUnassign\", \"description\": \"Unassign the Business Account Manager from the Client.\", \"isCompleted\": false}, \"2\": {\"name\": \"Assign a Consultant\", \"value\": null, \"isDisabled\": false, \"onComplete\": \"process_function_TaskAssign\", \"description\": \"Assign a Consultant to the Client.\", \"isCompleted\": false}, \"3\": {\"name\": \"Prospect is Allocated\", \"value\": null, \"isDisabled\": true, \"onComplete\": \"process_function_LeadAllocated\", \"description\": \"Trigger Allocated on the Prospect.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Assign a Consultant to the Client.\", \"isCompleted\": false}, \"7\": {\"icon\": \"arrow-repeat\", \"name\": \"In Progress\", \"color\": \"blue\", \"tasks\": {\"1\": {\"name\": \"Close the Account\", \"value\": null, \"isDisabled\": false, \"onComplete\": \"process_function_ClientClose\", \"description\": \"Terminate all Services of this client.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"Working with the Client.\", \"isCompleted\": false}, \"8\": {\"icon\": \"check-circle\", \"name\": \"Completed\", \"color\": \"success\", \"tasks\": {\"1\": {\"name\": \"All Services are Terminated\", \"value\": null, \"isDisabled\": true, \"onComplete\": null, \"description\": \"All services have been provided and terminated.\", \"isCompleted\": false}}, \"value\": null, \"onComplete\": null, \"description\": \"The process is completed\", \"isCompleted\": false}}",
        "organization": 10000,
        "targetTable": "clients"
    },
